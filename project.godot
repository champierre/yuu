window/handheld/orientation=0

[rendering]

environment/defaults/default_clear_color=Color(1, 1, 1, 1)

[gui]

theme/custom_font="res://fonts/NotoSansJP-Regular.otf"

[autoload]

Game="*res://scripts/game.gd"

